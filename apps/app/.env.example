# Copy to `.env.local` (git-ignored) and fill in. EXPO_PUBLIC_* values are
# inlined into the client bundle, so only put publishable values here:
# the Supabase anon key is safe to ship, the service-role key is NOT.
#
# For EAS builds set the same values as EAS environment variables
# (`eas env:create`) or in the eas.json build profile `env` block.

# Supabase project URL, e.g. https://<ref>.supabase.co
# (local stack from `supabase start`: http://127.0.0.1:54321)
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Sign-in (phase 2) -------------------------------------------------------
# Google, native (iOS + Android): OAuth client ids from Google Cloud Console.
#  - WEB client id: the one Supabase's Google provider is configured with. Both
#    platforms pass it to GoogleSignin.configure({ webClientId }) so the ID
#    token's audience is the web client, which is what signInWithIdToken checks.
#  - IOS client id: the iOS OAuth client for the app's bundle id.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# The iOS client's REVERSED id (com.googleusercontent.apps.<digits>-<hash>).
# Read by app.config.ts at build time (not inlined) for the Info.plist URL scheme.
GOOGLE_IOS_URL_SCHEME=

# Terms / Privacy links on Welcome (placeholders until the pages exist).
EXPO_PUBLIC_TERMS_URL=https://www.claude-calendar.com/terms
EXPO_PUBLIC_PRIVACY_URL=https://www.claude-calendar.com/privacy
# Where "Contact support" mails (placeholder address; set the real one).
EXPO_PUBLIC_SUPPORT_EMAIL=support@claude-calendar.com
