# Secrets for `supabase functions serve --env-file supabase/functions/.env` (local). Copy to .env
# (untracked) and fill in. On a hosted project set them with `supabase secrets set NAME=value`.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by the platform.

# ai-schedule
ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-haiku-4-5          # default: the prototype's model
# AI_MONTHLY_LIMIT=200               # notes per user per UTC month (open question 1)
# AI_PER_MINUTE=6                    # calls per user per minute
# AI_TRANSPORT=inline                # or skills; default: skills when all four ids below are set
# SKILL_ID_CALENDAR_SCHEDULER=skill_...    # printed by ai-schedule/upload-skills.ts
# SKILL_ID_CALENDAR_GOAL_ADJUST=skill_...
# SKILL_ID_CALENDAR_CHECKIN=skill_...
# SKILL_ID_CALENDAR_VERIFIER=skill_...
