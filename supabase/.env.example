# Read by supabase/config.toml (env(...) substitution) when you run `supabase start`.
# Copy to supabase/.env.local (git-ignored) and fill in. Dummy values are enough for database work;
# real ones are needed only to sign in with the providers.
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=com.example.calendar.signin
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=dummy
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=dummy.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=dummy
